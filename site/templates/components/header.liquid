{% comment %} header: site, t, home_url, langs_menu (this page in each language it exists in: lang, url, name, current), lang (the page language), events_url, gallery_url, menu_url, on_photo (true when the page starts with the hero photo). The theme switch (coffee cup: day colours, cocktail: night colours) is shown by site.js, so it is absent without JavaScript. The language menu is a disclosure, so it opens without JavaScript; site.js closes it on a click outside and remembers the language picked. {% endcomment %}
<header class="site-header{% if on_photo %} on-photo{% endif %}">
  <div class="wrap site-header__row">
    <a class="brand" href="{{ home_url | url }}" aria-label="{{ site.legal_name }}">
      <img class="brand__mark theme-invert" src="{{ '/assets/brand/logo-roundel-white.png' | asset }}" alt="" width="44" height="44">
      <img class="brand__word theme-invert" src="{{ '/assets/brand/wordmark-white.png' | asset }}" alt="{{ site.name }}" width="117" height="40">
    </a>
    <nav class="site-nav" aria-label="{{ site.name }}">
      <a class="nav-link" href="{{ events_url | url }}">{% render 'components/nav-icon', name: 'events' %}<span class="nav-link__text">{{ t.nav_events }}</span></a>
      <a class="nav-link" href="{{ gallery_url | url }}">{% render 'components/nav-icon', name: 'moments' %}<span class="nav-link__text">{{ t.nav_gallery }}</span></a>
      <a class="nav-link" href="{{ menu_url | url }}">{% render 'components/nav-icon', name: 'menu' %}<span class="nav-link__text">{{ t.nav_menu }}</span></a>
    </nav>
    <div class="site-header__side">
      {% render 'components/open-pill', t: t %}
      <button class="theme-switch" type="button" role="switch" aria-checked="true" aria-label="{{ t.theme_switch }}" data-theme-switch hidden><span data-theme-side="day" aria-hidden="true">☕</span><span data-theme-side="night" aria-hidden="true">🍸</span></button>
      {%- if langs_menu.size > 1 %}
      <details class="langs" data-langs>
        <summary class="langs__now" aria-label="{{ t.lang_menu }}: {{ t.lang_name }}">{{ lang | upcase }}<span class="langs__arrow" aria-hidden="true"></span></summary>
        <ul class="langs__menu">
          {%- for l in langs_menu %}
          <li><a class="langs__item" href="{{ l.url | url }}" hreflang="{{ l.lang }}" lang="{{ l.lang }}" data-lang="{{ l.lang }}"{% if l.current %} aria-current="page"{% endif %}><span class="langs__code" aria-hidden="true">{{ l.lang | upcase }}</span> {{ l.name }}</a></li>
          {%- endfor %}
        </ul>
      </details>
      {%- endif %}
    </div>
  </div>
</header>
