{% comment %} nav-icon: name ('events', 'moments', 'menu' or 'coffee'). A small badge in the manner of the ROBIN's roundel: a ring, a dotted inner ring like the logo's ornament, and a line drawing in the middle: a calendar for what's on, an eye for the moments, a cocktail glass for the menu (and the night side of the theme switch), a coffee cup for the day side. Drawn in currentColor, so it follows the text colour and the theme; decorative (aria-hidden), the link carries the words. {% endcomment %}
<svg class="nav-icon" viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
  <circle cx="16" cy="16" r="14.6" stroke-width="1.6"/>
  <circle cx="16" cy="16" r="12.2" stroke-width="1.1" stroke-dasharray="0.1 2.4"/>
  {%- case name %}
  {%- when 'events' %}
  <rect x="9.6" y="10.6" width="12.8" height="11.4" rx="1.6" stroke-width="1.6"/>
  <path d="M9.6 14.4h12.8M13 8.8v3.4M19 8.8v3.4" stroke-width="1.6"/>
  <path d="M12.8 17.6h.01M16 17.6h.01M19.2 17.6h.01M12.8 20h.01M16 20h.01" stroke-width="2"/>
  {%- when 'moments' %}
  <path d="M7.8 16c2.2-3.6 5-5.4 8.2-5.4s6 1.8 8.2 5.4c-2.2 3.6-5 5.4-8.2 5.4s-6-1.8-8.2-5.4z" stroke-width="1.6"/>
  <circle cx="16" cy="16" r="2.9" stroke-width="1.6"/>
  <circle cx="16" cy="16" r="0.9" fill="currentColor" stroke="none"/>
  {%- when 'menu' %}
  <path d="M9.4 10.4h13.2L16 17.4z" stroke-width="1.6"/>
  <path d="M16 17.4v4.6M12.8 22.4h6.4M19.6 8.2l-2.4 4.4" stroke-width="1.6"/>
  <circle cx="20.2" cy="7.6" r="1.1" fill="currentColor" stroke="none"/>
  {%- when 'coffee' %}
  <path d="M9.6 13.6h10.4v4.2a4.4 4.4 0 0 1-4.4 4.4h-1.6a4.4 4.4 0 0 1-4.4-4.4z" stroke-width="1.6"/>
  <path d="M20 15h.9a2 2 0 0 1 0 4H20M8.4 24h13.2" stroke-width="1.6"/>
  <path d="M13 8.4c-.7.8.7 1.6 0 2.6M16.6 8.4c-.7.8.7 1.6 0 2.6" stroke-width="1.3"/>
  {%- endcase %}
</svg>
