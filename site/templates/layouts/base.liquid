{%- comment %} base: the frame of every page: head (meta, link preview, favicons, theme script), header, main, footer, the one script. Every other layout fills its `content` block. {% endcomment -%}
<!doctype html>
<html lang="{{ page.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.description }}">
{%- if noindex %}
<meta name="robots" content="noindex, nofollow">
{%- endif %}
{%- unless page.permalink %}
{%- for a in alternates %}
<link rel="alternate" hreflang="{{ a.lang }}" href="{{ a.url | absolute }}">
{%- endfor %}
{%- if x_default %}
<link rel="alternate" hreflang="x-default" href="{{ x_default | absolute }}">
{%- endif %}
<link rel="canonical" href="{{ page.url | absolute }}">
<meta property="og:url" content="{{ page.url | absolute }}">
{%- endunless %}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.legal_name }}">
<meta property="og:title" content="{{ page.title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:locale" content="{{ t.og_locale }}">
{%- for locale in og_locales_other %}
<meta property="og:locale:alternate" content="{{ locale }}">
{%- endfor %}
{%- if og %}
<meta property="og:image" content="{{ og.path | absolute }}">
<meta property="og:image:width" content="{{ og.width }}">
<meta property="og:image:height" content="{{ og.height }}">
<meta property="og:image:alt" content="{{ og.alt }}">
<meta name="twitter:card" content="summary_large_image">
{%- endif %}
<meta name="theme-color" content="{{ tokens.color.night.bg }}" data-night="{{ tokens.color.night.bg }}" data-day="{{ tokens.color.day.bg }}">
<link rel="icon" href="{{ '/favicon.ico' | url }}" sizes="32x32">
<link rel="icon" type="image/png" sizes="192x192" href="{{ '/assets/icons/icon-192.png' | asset }}">
<link rel="apple-touch-icon" href="{{ '/assets/icons/apple-touch-icon.png' | asset }}">
{%- if page.layout == 'editor' %}
<link rel="manifest" href="{{ '/edit/manifest.webmanifest' | url }}">
{%- endif %}
<link rel="preload" href="{{ '/assets/fonts/alfa-slab-one.woff2' | url }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ '/assets/site.css' | asset }}">
<script>
// Coffee or cocktail: the page follows the device. Light mode gives the coffee colours,
// dark mode the cocktail colours, so a phone that turns dark at sunset turns the page
// with it (site.js follows a change while the page is open). The switch in the header
// overrules the device for this visit; ?theme=day or ?theme=night overrules both. A
// browser that cannot tell its mode falls back to the Zürich clock. Runs before first
// paint so the theme never flashes. Without JavaScript the page stays "night".
(function () {
  try {
    var forced = new URLSearchParams(location.search).get("theme");
    var chosen = null;
    try { chosen = sessionStorage.getItem("theme"); } catch (e) {}
    var device = null;
    if (window.matchMedia) {
      if (matchMedia("(prefers-color-scheme: dark)").matches) device = "night";
      else if (matchMedia("(prefers-color-scheme: light)").matches) device = "day";
    }
    if (!device) {
      var h = +new Intl.DateTimeFormat("en-GB", { hour: "2-digit", hour12: false, timeZone: "{{ site.timezone }}" }).format(new Date());
      device = h >= 6 && h < 17 ? "day" : "night";
    }
    var theme = forced || chosen || device;
    document.documentElement.dataset.theme = theme === "day" ? "day" : "night";
    var bar = document.querySelector('meta[name="theme-color"]');
    bar.content = bar.getAttribute("data-" + document.documentElement.dataset.theme);
  } catch (e) {}
})();
</script>
<script type="application/ld+json">{{ json_ld | json | raw }}</script>
</head>
<body>
<a class="skip" href="#main">{{ t.skip }}</a>
{% assign on_photo = false %}{% if page.layout == 'home' %}{% assign on_photo = true %}{% endif %}
{% render 'components/header', site: site, t: t, home_url: home_url, other: other, events_url: events_url, gallery_url: gallery_url, on_photo: on_photo %}
<main id="main">
{% block content %}{% endblock %}
</main>
{% render 'components/footer', site: site, t: t, hours_rows: hours_rows %}
<script type="application/json" id="hours-data">{{ hours | json | raw }}</script>
<script type="application/json" id="i18n-data">{{ t | json | raw }}</script>
<script src="{{ '/assets/js/site.js' | asset }}" defer></script>
</body>
</html>
