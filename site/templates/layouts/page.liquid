{% layout 'layouts/base' %}
{% comment %} page: a plain text page from a Markdown file: title and prose. {% endcomment %}
{% block content %}
<section class="section">
  <div class="wrap prose">
    <h1 class="h-xl">{{ page.title }}</h1>
    {{ page.content | raw }}
  </div>
</section>
{% endblock %}
