{% layout 'layouts/base' %}
{% comment %} editor: the frame of the editor at /edit/. The screens are drawn by edit/editor.js (src/editor/); it reads the site's files from edit/site.json. The editor speaks English and German and picks by the browser (src/editor/strings.ts); this frame is the same for both. noindex. {% endcomment %}
{% block content %}
<section class="section">
  <div class="wrap editor" id="editor" data-bundle="{{ '/edit/site.json' | url }}" data-sw="{{ '/edit/sw.js' | url }}" data-version="{{ '/edit/version.json' | url }}">
    <h1 class="h-xl">{{ page.heading }}</h1>
    <p class="ed-note">{{ page.loading }}</p>
    <noscript><p>{{ page.noscript }}</p></noscript>
  </div>
</section>
<script type="module" src="{{ '/edit/editor.js' | asset }}"></script>
{% endblock %}
