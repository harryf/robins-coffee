{% comment %} about: page (about_title, content, lang), home (about_photos), photos. The roundel, the text of the home page file and the strip of four photos. {% endcomment %}
<section class="section section--surface" id="about">
  <div class="wrap about">
    <img class="about__roundel theme-invert" src="{{ '/assets/brand/logo-roundel-white.png' | asset }}" alt="" width="173" height="173" loading="lazy">
    <div class="prose">
      <h2 class="h-xl">{{ page.about_title }}</h2>
      {{ page.content | raw }}
    </div>
  </div>
  <div class="wrap about__photos">
    {% render 'components/photo-strip', items: home.about_photos, photos: photos, lang: page.lang %}
  </div>
</section>
