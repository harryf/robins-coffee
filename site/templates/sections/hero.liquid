<section class="hero">
  <div class="hero__photo">
    {% render 'components/photo', img: photos[home.hero_photo], alt: '', sizes: '100vw', eager: true %}
  </div>
  <div class="wrap hero__body">
    <p class="eyebrow">{{ page.kicker }}</p>
    <h1 class="hero__title">{{ page.headline | neon_last | raw }}</h1>
    <p class="hero__actions">
      <a class="btn btn--neon" href="#visit">{{ page.visit_title }}</a>
      <a class="btn" href="{{ site.phone | tel }}">{{ t.call }}</a>
    </p>
  </div>
</section>
