{% comment %} Home: the drinks of the season shown today (menu.yml; between seasons the one that ended last), each card a link to the drink's page, then a link to the menu page with every season. Left out when the menu has no drink. {% endcomment %}
{%- if menu.drinks.size > 0 %}
<section class="section section--surface" id="menu">
  <div class="wrap">
    <h2 class="h-xl">{{ t.menu_title }}</h2>
    <div class="menu-part">
      <h3 class="eyebrow">{{ menu.name }}</h3>
      <div class="drinks">
        {%- for d in menu.drinks %}
        {% render 'components/drink-card', d: d %}
        {%- endfor %}
      </div>
    </div>
    {%- if menu.url %}
    <p><a class="btn" href="{{ menu.url | url }}">{{ t.menu_all }}</a></p>
    {%- endif %}
  </div>
</section>
{%- endif %}
