{% comment %} moments: page (moments_title), moments, home (moments_count), t, gallery_url. The newest photos and a link to the gallery. {% endcomment %}
<section class="section" id="moments">
  <div class="wrap">
    <h2 class="h-xl">{{ page.moments_title }}</h2>
    {% render 'components/moments-grid', moments: moments, t: t, count: home.moments_count %}
    <p><a class="btn" href="{{ gallery_url | url }}">{{ t.gallery_all }}</a></p>
  </div>
</section>
