<section class="section" id="visit">
  <div class="wrap">
    <h2 class="h-xl">{{ page.visit_title }}</h2>
    <div class="visit">
      <div class="card">
        <h3 class="eyebrow">{{ t.address }}</h3>
        <p class="lead">{{ site.street }}<br>{{ site.postal_code }} {{ site.city }}</p>
        <p><a class="btn btn--neon" href="{{ site.maps_url }}" rel="noopener">{{ t.map }}</a></p>
      </div>
      <div class="card">
        <h3 class="eyebrow">{{ t.hours }}</h3>
        {% render 'components/hours', hours_rows: hours_rows, t: t %}
        <p>{% render 'components/open-pill', t: t %}</p>
      </div>
      <div class="card">
        <h3 class="eyebrow">{{ t.contact }}</h3>
        <p class="lead"><a href="{{ site.phone | tel }}">{{ site.phone }}</a><br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p><a class="btn" href="https://www.instagram.com/{{ site.instagram }}/" rel="noopener">{{ t.instagram }}</a></p>
      </div>
    </div>
  </div>
</section>
